{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Q3_A_LL",
            "command": "/usr/bin/gcc",
            "args": [
                "-g",
                "${workspaceFolder}/data_structures_docker/Data-Structures/Linked_List/Q3_A_LL.c",
                "-o",
                "${workspaceFolder}/data_structures_docker/Data-Structures/Linked_List/Q3_A_LL"
            ],
            "options": {
                "cwd": "${workspaceFolder}/data_structures_docker/Data-Structures/Linked_List"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}